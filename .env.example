# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=

# Public URL of the app (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (from M10)
RESEND_API_KEY=
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=

# Protects /api/cron/* (from M11)
CRON_SECRET=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up: without it, encrypted fields can't be read.
ENCRYPTION_KEY=

# Reads values from photos (licence expiry) and, in Phase 2, job reports. console.anthropic.com
ANTHROPIC_API_KEY=

# US address suggestions (Google Places API New). Server-only; restrict the key to the Places API.
GOOGLE_MAPS_API_KEY=
