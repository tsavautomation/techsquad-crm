# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=

# Public URL of the app (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (from M10)
RESEND_API_KEY=
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=

# Protects /api/cron/* (from M11)
CRON_SECRET=
